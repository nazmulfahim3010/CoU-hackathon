# Copy to .env and fill in. Never commit real keys. Keys stay on the backend only.

# Application mode: demo | live
APP_MODE=demo

# Session configuration
SESSION_TTL_MINUTES=30
SESSION_TTL_SECONDS=1800

# Speech-to-text: none | local_transformers | hf_inference | openai_compatible
SPEECH_PROVIDER=none
SPEECH_MODEL=bangla-speech-processing/BanglaASR
# Optional for local_transformers (needs only model download). Required for cloud endpoints:
SPEECH_API_KEY=
# Optional override. openai_compatible default: https://api.openai.com/v1 (model e.g. whisper-1)
SPEECH_BASE_URL=

# Configurable LLM (dialect normalization + clinical extraction): none | anthropic | openai_compatible
# Supports Anthropic Messages API or any OpenAI-compatible endpoint (OpenAI, Groq, Ollama, vLLM)
LLM_PROVIDER=none
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=

# Bangla TTS: gtts | none (runs in-memory via gTTS; zero API keys required)
TTS_PROVIDER=gtts

# Audio upload limits
MAX_AUDIO_SECONDS=90
MAX_UPLOAD_MB=25
MAX_AUDIO_BYTES=26214400
PROVIDER_TIMEOUT_SECONDS=60
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
