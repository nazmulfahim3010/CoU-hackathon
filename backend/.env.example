# Copy to .env and fill in. Never commit real keys. Keys stay on the backend only.

# Speech-to-text: none | hf_inference | openai_compatible
SPEECH_PROVIDER=none
SPEECH_MODEL=bangla-speech-processing/BanglaASR
SPEECH_API_KEY=
# Optional override. openai_compatible default: https://api.openai.com/v1 (model e.g. whisper-1)
SPEECH_BASE_URL=

# LLM (dialect normalization + clinical extraction): none | anthropic | openai_compatible
LLM_PROVIDER=none
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=

# Bangla TTS: gtts | none
TTS_PROVIDER=gtts
TTS_API_KEY=

MAX_AUDIO_BYTES=10485760
SESSION_TTL_SECONDS=1800
PROVIDER_TIMEOUT_SECONDS=60
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
