# Copy to .env and fill in. Never commit real keys. Keys stay on the backend only.

# Application mode: demo | live
APP_MODE=demo

# Session configuration
SESSION_TTL_MINUTES=30
SESSION_TTL_SECONDS=1800

# Speech-to-text: none | local_transformers | hf_inference | openai_compatible
SPEECH_PROVIDER=none
# Leave SPEECH_MODEL empty to use the provider's own default (never mix model ids between providers, that
# causes HTTP 400). Defaults: Groq -> whisper-large-v3, OpenAI -> whisper-1, hf_inference -> openai/whisper-large-v3.
SPEECH_MODEL=
SPEECH_API_KEY=
SPEECH_BASE_URL=
#
# --- Recommended, verified: Groq Whisper (OpenAI-compatible, multipart upload, Bearer key) ---
# SPEECH_PROVIDER=openai_compatible
# SPEECH_BASE_URL=https://api.groq.com/openai/v1
# SPEECH_MODEL=whisper-large-v3        # or whisper-large-v3-turbo (verified working)
# SPEECH_API_KEY=your_groq_key
#
# --- OpenAI ---
# SPEECH_PROVIDER=openai_compatible   (leave SPEECH_BASE_URL empty)   SPEECH_MODEL=whisper-1
#
# --- Hugging Face Inference (NOT recommended): most Whisper repos, including bangla-speech-processing/BanglaASR,
# --- return HTTP 400 "Model not supported by provider hf-inference". openai/whisper-large-v3 is served but needs
# --- pre-paid HF credits (HTTP 402 otherwise).
# SPEECH_PROVIDER=hf_inference   SPEECH_MODEL=openai/whisper-large-v3

# Configurable LLM (dialect normalization + clinical extraction): none | anthropic | openai_compatible
# Supports Anthropic Messages API or any OpenAI-compatible endpoint (OpenAI, Groq, Ollama, vLLM)
LLM_PROVIDER=none
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=

# Bangla TTS: gtts | none (runs in-memory via gTTS; zero API keys required)
TTS_PROVIDER=gtts

# Audio upload limits
MAX_AUDIO_SECONDS=90
MAX_UPLOAD_MB=10
MAX_AUDIO_BYTES=10485760
PROVIDER_TIMEOUT_SECONDS=60
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Sharing a summary card with a health worker (in-memory only, consent required)
SHARE_TTL_MINUTES=30
# Address a phone can reach, so share links/QR codes work on the same Wi-Fi, e.g. http://192.168.1.20:8080
PUBLIC_BASE_URL=
